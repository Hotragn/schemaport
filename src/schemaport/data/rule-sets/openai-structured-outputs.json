{
  "rule_set_id": "openai-structured-outputs",
  "summary": "The strict Structured Outputs schema subset and limits, plus automatic prefix-cache shape. Shared by the Chat Completions and Responses profiles, which differ only in where the schema sits in the request.",
  "rules": [
    {
      "rule_id": "structured-output.strict-not-enabled",
      "check": "structured_output.strict_not_enabled",
      "severity": "info",
      "confidence": "documented",
      "params": {},
      "message": "The request supplies a json_schema format without opting into strict mode.",
      "remediation": "Set \"strict\": true alongside the schema, then make the schema satisfy the strict subset. Without it the schema is a hint rather than an enforced contract.",
      "provenance": {
        "source_kind": "provider_documentation",
        "reference": "OpenAI \"Structured Outputs\" guide: schema adherence is guaranteed only when strict is enabled on the json_schema format. https://developers.openai.com/api/docs/guides/structured-outputs",
        "evidence_date": "2026-08-15"
      }
    },
    {
      "rule_id": "structured-output.root-not-object",
      "check": "structured_output.root_type",
      "severity": "error",
      "confidence": "documented",
      "applies_to_kinds": [
        "response_format"
      ],
      "requires_strict": true,
      "params": {
        "expected_type": "object"
      },
      "message": "The root of a strict json_schema must declare type \"object\".",
      "remediation": "Wrap the current schema in an object: set \"type\": \"object\" at the root and move the existing schema under a named property, for example \"items\" or \"result\".",
      "provenance": {
        "source_kind": "provider_documentation",
        "reference": "OpenAI \"Structured Outputs\" guide, supported schemas: \"root level object of a schema must be an object, and not use anyOf\". https://developers.openai.com/api/docs/guides/structured-outputs",
        "evidence_date": "2026-08-15"
      },
      "probe": {
        "expectation": "Rejected: the root of a strict schema must be an object.",
        "requests": {
          "openai.responses": {
            "request": {
              "input": "ping",
              "max_output_tokens": 16,
              "text": {
                "format": {
                  "type": "json_schema",
                  "name": "probe",
                  "strict": true,
                  "schema": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "control": {
              "input": "ping",
              "max_output_tokens": 16,
              "text": {
                "format": {
                  "type": "json_schema",
                  "name": "probe",
                  "strict": true,
                  "schema": {
                    "type": "object",
                    "properties": {
                      "answer": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "answer"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "openai.chat_completions": {
            "request": {
              "messages": [
                {
                  "role": "user",
                  "content": "ping"
                }
              ],
              "max_tokens": 1,
              "response_format": {
                "type": "json_schema",
                "json_schema": {
                  "name": "probe",
                  "strict": true,
                  "schema": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "control": {
              "messages": [
                {
                  "role": "user",
                  "content": "ping"
                }
              ],
              "max_tokens": 1,
              "response_format": {
                "type": "json_schema",
                "json_schema": {
                  "name": "probe",
                  "strict": true,
                  "schema": {
                    "type": "object",
                    "properties": {
                      "answer": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "answer"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "rule_id": "structured-output.root-uses-anyof",
      "check": "structured_output.root_forbidden_keywords",
      "severity": "error",
      "confidence": "documented",
      "applies_to_kinds": [
        "response_format"
      ],
      "requires_strict": true,
      "params": {
        "keywords": [
          "anyOf"
        ]
      },
      "message": "A strict json_schema may not use anyOf at its root.",
      "remediation": "Move the anyOf one level down: make the root an object with a single property whose schema carries the anyOf.",
      "provenance": {
        "source_kind": "provider_documentation",
        "reference": "OpenAI \"Structured Outputs\" guide, supported schemas: \"root level object of a schema must be an object, and not use anyOf\". https://developers.openai.com/api/docs/guides/structured-outputs",
        "evidence_date": "2026-08-15"
      }
    },
