        "source_kind": "provider_documentation",
        "reference": "OpenAI \"Structured Outputs\" guide, supported schemas: \"additionalProperties: false must always be set in objects\". https://developers.openai.com/api/docs/guides/structured-outputs",
        "evidence_date": "2026-08-15"
