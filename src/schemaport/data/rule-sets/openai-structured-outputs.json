    {
      "rule_id": "structured-output.property-not-required",
      "check": "structured_output.required_completeness",
      "severity": "error",
      "confidence": "documented",
      "applies_to_kinds": [
        "response_format",
        "tool_parameters"
      ],
      "requires_strict": true,
      "params": {},
      "message": "Every property declared on an object in a strict schema must appear in that object's \"required\" array.",
      "remediation": "Add the missing property names to this object's \"required\" array. For a field that is genuinely optional, keep it required and widen its type to a union that includes \"null\" rather than leaving it out.",
      "provenance": {
        "source_kind": "provider_documentation",
        "reference": "OpenAI \"Structured Outputs\" guide, supported schemas: \"All fields or function parameters must be specified as required\"; optional fields are expressed as a union with null. https://developers.openai.com/api/docs/guides/structured-outputs",
        "evidence_date": "2026-08-15"
      },
      "probe": {
        "expectation": "Rejected: strict mode requires every property to appear in required.",
        "requests": {
          "openai.responses": {
