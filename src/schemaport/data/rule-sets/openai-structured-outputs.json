    {
      "rule_id": "structured-output.unsupported-keyword",
      "check": "structured_output.unsupported_keywords",
      "severity": "error",
      "confidence": "documented",
      "applies_to_kinds": [
        "response_format",
        "tool_parameters"
      ],
      "requires_strict": true,
      "params": {
        "keywords": [
          "allOf",
          "not",
          "dependentRequired",
          "dependentSchemas",
          "if",
          "then",
          "else"
        ]
      },
      "message": "This composition keyword is outside the JSON Schema subset accepted under strict mode.",
      "remediation": "Remove the keyword. Use \"anyOf\" in place of \"allOf\", merge the combined constraints into a single schema, and replace conditional keywords with an \"anyOf\" over the concrete shapes you accept.",
      "provenance": {
        "source_kind": "provider_documentation",
        "reference": "OpenAI \"Structured Outputs\" guide, supported schemas: the unsupported composition keywords are \"allOf, not, dependentRequired, dependentSchemas, if, then, else\". https://developers.openai.com/api/docs/guides/structured-outputs",
        "evidence_date": "2026-08-15"
      },
      "probe": {
        "expectation": "Rejected: allOf is outside the strict-mode subset.",
