        "properties": {
          "customer_id": { "type": "string" },
          "status": {
            "allOf": [{ "type": "string" }, { "enum": ["open", "closed"] }]
          },
          "note": { "type": "string" }
        },
        "required": ["customer_id"]
      }
    }
  }
